extends Node3D
## Port of app/forest/vegetation.ts (trees): eight tree variants (oak, beech, oak, birch x 2 seeds) generated by
## tree_gen.gd on worker threads, placed exactly as the original (six hero trunks around the trail, a grove, an
## outer woodland and the far landscape, ~7,000 trees), each tilted to the slope with its root flare sunk into the
## ground. Trees within 250 m are drawn per 20 m cell and variant, the cell switching high/medium/low/horizon detail
## by its distance as in the original; the far landscape uses horizon-detail pools per 160 m tile.

const FM := preload("res://forest_math.gd")
const TreeGen := preload("res://tree_gen.gd")
const SPECIES := ["oak", "beech", "oak", "birch"]
const NEAR_HALF := 250.0
const LOD_DIST := [24.0, 56.0, 150.0, 450.0]

var variants: Array = []          # {wood: [high, medium, low, horizon], leaves: [...], ring, trunk_radius}
var positions: Array = []         # {x, z, s, v, rot}
var tree_matrices: Array = []     # Transform3D per position
var near_cells: Array = []        # {center: Vector2, nodes: [[mmi_wood, mmi_leaves, v]]}
var bark_mats: Array = []
var leaf_mat := ShaderMaterial.new()
var lod_clock := 0.0
var stats := {}


func _ready() -> void:
	var t0 := Time.get_ticks_msec()
	_build_variants()
	var t1 := Time.get_ticks_msec()
	_place_trees()
	_build_materials()
	_build_instances()
	stats.ms_generate = t1 - t0
	stats.ms_place = Time.get_ticks_msec() - t1
	print("vegetation: %d trees, variants %d ms, placement %d ms" % [positions.size(), stats.ms_generate, stats.ms_place])


func _build_variants() -> void:
	variants.resize(8)
	var task := WorkerThreadPool.add_group_task(_generate_variant, 8, -1, true, "trees")
	WorkerThreadPool.wait_for_group_task_completion(task)
	for v in variants:
		v.wood.append(v.wood[2])
		v.leaves.append(_horizon_leaves(v.leaves[2]))


func _generate_variant(i: int) -> void:
	var g := TreeGen.new()
	variants[i] = g.generate(215 + i * 819, SPECIES[i % 4])


## distant-trees.ts createHorizonGeometry (leaves): every third low-detail leaf, enlarged 1.69x about its base.
static func _horizon_leaves(low: ArrayMesh) -> ArrayMesh:
	var a := low.surface_get_arrays(0)
	var pos: PackedVector3Array = a[Mesh.ARRAY_VERTEX]
	var nrm: PackedVector3Array = a[Mesh.ARRAY_NORMAL]
	var col: PackedColorArray = a[Mesh.ARRAY_COLOR]
	var uv: PackedVector2Array = a[Mesh.ARRAY_TEX_UV]
	var p2 := PackedVector3Array(); var n2 := PackedVector3Array(); var c2 := PackedColorArray(); var u2 := PackedVector2Array()
	var idx := PackedInt32Array()
	var leaf := 0
	for base in range(0, pos.size(), 4):
		if leaf % 3 == 0:
			var first := p2.size()
			for k in 4:
				p2.append(pos[base] + (pos[base + k] - pos[base]) * 1.69)
				n2.append(nrm[base + k]); c2.append(col[base + k]); u2.append(uv[base + k])
			idx.append_array([first, first + 3, first + 1, first, first + 2, first + 3])
		leaf += 1
	var arr := []
	arr.resize(Mesh.ARRAY_MAX)
	arr[Mesh.ARRAY_VERTEX] = p2; arr[Mesh.ARRAY_NORMAL] = n2; arr[Mesh.ARRAY_COLOR] = c2; arr[Mesh.ARRAY_TEX_UV] = u2
	arr[Mesh.ARRAY_INDEX] = idx
	var m := ArrayMesh.new()
	m.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arr)
	return m


## vegetation.ts positions: same random streams and rejection rules; the spacing tests use a grid (same result).
func _place_trees() -> void:
	var r := FM.rng(716126)
	var grid := {}
	var add := func(p: Dictionary) -> void:
		positions.append(p)
		var key := Vector2i(floori(p.x / 6.0), floori(p.z / 6.0))
		if not grid.has(key):
			grid[key] = []
		grid[key].append(p)
	var near := func(x: float, z: float, d: float) -> bool:
		var gx := floori(x / 6.0); var gz := floori(z / 6.0)
		for dz in range(-1, 2):
			for dx in range(-1, 2):
				for q in grid.get(Vector2i(gx + dx, gz + dz), []):
					if (q.x - x) * (q.x - x) + (q.z - z) * (q.z - z) < d * d:
						return true
		return false
	for h in [[-6.5, 5.0, 1.15, 0], [8.0, -3.0, 1.16, 1], [-11.0, -17.0, 1.25, 2], [15.0, -22.0, 1.0, 4], [-4.0, -35.0, 1.1, 5], [19.0, 16.0, 0.98, 0]]:
		add.call({"x": h[0], "z": h[1], "s": h[2], "v": h[3], "rot": r.call() * 6.28})
	for i in 1700:
		var x: float = (r.call() - 0.5) * 246.0
		var z: float = (r.call() - 0.5) * 246.0
		if FM.trail_distance(x, z) < 2.3 or near.call(x, z, 5.3):
			continue
		add.call({"x": x, "z": z, "s": 0.7 + r.call() * 0.45, "v": floori(r.call() * 8), "rot": r.call() * 6.28})
	for i in 3200:
		var x: float = (r.call() - 0.5) * 440.0
		var z: float = (r.call() - 0.5) * 440.0
		if absf(x) < 122.0 and absf(z) < 122.0:
			continue
		if near.call(x, z, 5.5):
			continue
		add.call({"x": x, "z": z, "s": 0.67 + r.call() * 0.54, "v": floori(r.call() * 8), "rot": r.call() * 6.28})
	var outer := FM.rng(170491)
	for i in 4500:
		var x: float = (outer.call() - 0.5) * 680.0
		var z: float = (outer.call() - 0.5) * 680.0
		if absf(x) < 220.0 and absf(z) < 220.0:
			continue
		if near.call(x, z, 5.5):
			continue
		add.call({"x": x, "z": z, "s": 0.67 + outer.call() * 0.54, "v": floori(outer.call() * 8), "rot": outer.call() * 6.28})
	var land := FM.rng(710283)
	for i in 7800:
		var x: float = (land.call() - 0.5) * FM.VEGETATION * 2.0
		var z: float = (land.call() - 0.5) * FM.VEGETATION * 2.0
		if absf(x) < 340.0 and absf(z) < 340.0:
			continue
		if near.call(x, z, 6.2):
			continue
		add.call({"x": x, "z": z, "s": 0.68 + land.call() * 0.64, "v": floori(land.call() * 8), "rot": land.call() * 6.28})
	# the understory continues this stream (vegetation.ts reuses r)
	set_meta("rng", r)

	for i in positions.size():
		var p: Dictionary = positions[i]
		var x: float = p.x
		var z: float = p.z
		var v: int = p.v
		var sx := (FM.height_at(x + 1.0, z) - FM.height_at(x - 1.0, z)) * 0.5
		var sz := (FM.height_at(x, z + 1.0) - FM.height_at(x, z - 1.0)) * 0.5
		var up := Vector3(-sx, 1.0, -sz).normalized()
		var tilt := Quaternion(Vector3.UP, up)
		var hero := i < 6
		var hs := func(salt: float) -> float: return fposmod(sin(x * 12.9898 + z * 78.233 + salt) * 43758.5453, 1.0)
		var wx: float = 1.0 if hero else 0.86 + hs.call(1.0) * 0.28
		var wz: float = 1.0 if hero else 0.86 + hs.call(2.0) * 0.28
		var vert: float = 1.0 if hero else 0.89 + hs.call(3.0) * 0.22
		var s: float = p.s
		var scale := Vector3(s * (0.86 + (v % 3) * 0.12) * wx, s * vert, s * wz)
		var basis := Basis(tilt) * Basis(Vector3.UP, p.rot) * Basis.from_scale(scale)
		var xf := Transform3D(basis, Vector3(x, FM.height_at(x, z) - 0.05, z))
		# sink the whole root flare just below the terrain, including convex ground between samples
		var gap := 0.0
		var ring: PackedVector3Array = variants[v].ground_ring
		for k in range(0, ring.size(), maxi(1, ring.size() / 24)):
			var g := xf * ring[k]
			gap = maxf(gap, g.y - FM.height_at(g.x, g.z) + 0.012)
		xf.origin.y -= gap
		tree_matrices.append(xf)


func _build_materials() -> void:
	var tints := {"oak": Color("#c6b298"), "beech": Color("#cfcec2"), "birch": Color("#e3dac5")}
	var depth := {"oak": 0.65, "beech": 0.27, "birch": 0.16}
	var bc: Texture2D = load("res://textures/bark-color.jpg")
	var bn: Texture2D = load("res://textures/bark-normal.jpg")
	for sp in SPECIES:
		var m := ShaderMaterial.new()
		m.shader = load("res://shaders/bark.gdshader")
		m.set_shader_parameter("species", ["oak", "beech", "birch"].find(sp))
		m.set_shader_parameter("tint", tints[sp])
		m.set_shader_parameter("normal_depth", depth[sp])
		m.set_shader_parameter("bark_color", bc)
		m.set_shader_parameter("bark_normal", bn)
		bark_mats.append(m)
	leaf_mat.shader = load("res://shaders/foliage.gdshader")
	leaf_mat.set_shader_parameter("kind", 0)
	leaf_mat.set_shader_parameter("roughness", 0.76)


func _mmi(mesh: Mesh, mat: Material, xfs: Array, origin: Vector3) -> MultiMeshInstance3D:
	var mm := MultiMesh.new()
	mm.transform_format = MultiMesh.TRANSFORM_3D
	mm.mesh = mesh
	mm.instance_count = xfs.size()
	var inv := Transform3D(Basis.IDENTITY, -origin)
	for i in xfs.size():
		mm.set_instance_transform(i, inv * xfs[i])
	var mi := MultiMeshInstance3D.new()
	mi.multimesh = mm
	mi.material_override = mat
	mi.position = origin
	return mi


func _build_instances() -> void:
	var cells := {}
	var far := {}
	for i in positions.size():
		var p: Dictionary = positions[i]
		var cx := floori(p.x / 20.0)
		var cz := floori(p.z / 20.0)
		var center := Vector2(cx * 20.0 + 10.0, cz * 20.0 + 10.0)
		if absf(center.x) < NEAR_HALF and absf(center.y) < NEAR_HALF:
			var key := Vector3i(cx, cz, p.v)
			if not cells.has(key):
				cells[key] = []
			cells[key].append(i)
		else:
			var key := Vector3i(floori(p.x / 160.0), floori(p.z / 160.0), p.v)
			if not far.has(key):
				far[key] = []
			far[key].append(i)
	var by_cell := {}
	for key in cells:
		var v: int = key.z
		var xfs := []
		for i in cells[key]:
			xfs.append(tree_matrices[i])
		var c2 := Vector2(key.x * 20.0 + 10.0, key.y * 20.0 + 10.0)
		var origin := Vector3(c2.x, FM.height_at(c2.x, c2.y), c2.y)
		var w := _mmi(variants[v].wood[0], bark_mats[v % 4], xfs, origin)
		var l := _mmi(variants[v].leaves[0], leaf_mat, xfs, origin)
		add_child(w)
		add_child(l)
		var ck := Vector2i(key.x, key.y)
		if not by_cell.has(ck):
			by_cell[ck] = {"center": c2, "nodes": [], "lod": -1}
		by_cell[ck].nodes.append([w, l, v])
	near_cells = by_cell.values()
	for key in far:
		var v: int = key.z
		var xfs := []
		for i in far[key]:
			xfs.append(tree_matrices[i])
		var c2 := Vector2(key.x * 160.0 + 80.0, key.y * 160.0 + 80.0)
		var origin := Vector3(c2.x, 0.0, c2.y)
		for part in 2:
			var mesh: Mesh = variants[v].wood[3] if part == 0 else variants[v].leaves[3]
			var mi := _mmi(mesh, bark_mats[v % 4] if part == 0 else leaf_mat, xfs, origin)
			mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
			mi.visibility_range_end = LOD_DIST[3] + 120.0
			add_child(mi)


func _process(delta: float) -> void:
	lod_clock -= delta
	if lod_clock > 0.0:
		return
	lod_clock = 0.3
	var cam := get_viewport().get_camera_3d()
	if cam == null:
		return
	var cp := Vector2(cam.global_position.x, cam.global_position.z)
	for c in near_cells:
		var d: float = cp.distance_to(c.center)
		var lod := 0 if d < LOD_DIST[0] else (1 if d < LOD_DIST[1] else (2 if d < LOD_DIST[2] else (3 if d < LOD_DIST[3] else 4)))
		if lod == c.lod:
			continue
		c.lod = lod
		for n in c.nodes:
			var w: MultiMeshInstance3D = n[0]
			var l: MultiMeshInstance3D = n[1]
			w.visible = lod < 4
			l.visible = lod < 4
			if lod < 4:
				w.multimesh.mesh = variants[n[2]].wood[lod]
				l.multimesh.mesh = variants[n[2]].leaves[lod]
			var sh := GeometryInstance3D.SHADOW_CASTING_SETTING_ON if d < 90.0 else GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
			w.cast_shadow = sh
			l.cast_shadow = sh
